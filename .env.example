# ==============================================================================
# ClicMénage — environment variables
# ==============================================================================
# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and must NEVER be committed. Every variable below is optional —
# the site runs in a clearly-labeled demo/mock mode when a variable is
# missing, so you can develop and preview the full site before any of these
# accounts exist. See LAUNCH_CHECKLIST.md for what's required before launch.
# ==============================================================================

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.clicmenage.ca

# --- Business contact info (used across the site + LocalBusiness schema) ----
# Every value in this section is BLANK by default on purpose. The site hides
# the phone/email/hours/address UI gracefully (no fake placeholder shown)
# until you fill these in — see src/lib/config/business.ts.
#
# Example values (uncomment and edit, don't leave a fake number live):
# NEXT_PUBLIC_BUSINESS_PHONE="(514) 555-0100"
# NEXT_PUBLIC_BUSINESS_PHONE_HREF="tel:+15145550100"
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_PHONE_HREF=
NEXT_PUBLIC_BUSINESS_EMAIL=

# Internal-only inbox for booking/contact notifications (never shown on the
# site). Falls back to NEXT_PUBLIC_BUSINESS_EMAIL if left blank.
BUSINESS_NOTIFICATION_EMAIL=

# Street address + postal code — only set these if ClicMénage wants a
# specific address published (many home-service businesses only publish a
# service region instead; that part is already handled without an env var).
NEXT_PUBLIC_BUSINESS_STREET=
NEXT_PUBLIC_BUSINESS_POSTAL_CODE=

# Business hours display strings (both required together, or hours stay
# hidden). Format is free text, shown as-is on the Contact page.
# NEXT_PUBLIC_BUSINESS_HOURS_FR="Lun–Ven : 8 h à 18 h · Sam : 9 h à 15 h"
# NEXT_PUBLIC_BUSINESS_HOURS_EN="Mon–Fri: 8 AM–6 PM · Sat: 9 AM–3 PM"
NEXT_PUBLIC_BUSINESS_HOURS_FR=
NEXT_PUBLIC_BUSINESS_HOURS_EN=

# --- Social links (leave blank to hide from the footer) ---------------------
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=

# --- Stripe (payments) -------------------------------------------------------
# Leave both blank to keep the booking flow in mock payment mode.
# See src/lib/payments/stripe.ts for the integration point.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email provider (transactional emails) -----------------------------------
# Leave blank to keep transactional emails in mock/logged mode.
# See src/lib/email/provider.ts for the integration point.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@clicmenage.ca

# --- Database (Supabase recommended) -----------------------------------------
# Leave blank to keep bookings in the in-memory dev store.
# See src/lib/db/bookings.ts for the integration point.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Analytics (all optional, all off by default) ----------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_META_PIXEL_ID=
